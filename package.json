{
  "name": "node-starter",
  "version": "1.0.0",
  "description": "A starter template for Node.js typescript scripts.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "jest",
    "test:watch": "concurrently -n tsc,jest -k \"tsc -p tsconfig.test.json --watch --preserveWatchOutput\" \"jest --watchAll\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.4",
    "concurrently": "^10.0.5",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
